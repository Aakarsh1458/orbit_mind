# OrbitMind Environment Configuration

# Application Environment: development, staging, production, test
APP_ENV=development

# AI Inference Mode: "mock" (deterministic verifiable testing) or "production" (genuine ML models)
AI_MODE=mock

# Database Connection (PostgreSQL + PostGIS with asyncpg)
# Example for Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/orbitmind
# Example for local development with SQLite fallback: sqlite+aiosqlite:///./orbitmind.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/orbitmind

# LLM Orchestration Provider Configuration
DEFAULT_LLM_PROVIDER=gemini

# Provider Credentials (Leave blank if using AI_MODE=mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

HF_TOKEN=
HF_MODEL_ID=

LOCAL_LLM_URL=http://localhost:11434/v1

# OpenRouter / NVIDIA Nemotron
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning:free

# Multi-Model Workload Specialization & Tiering
LLM_STAGE_QUERY_UNDERSTANDING_PRIMARY_PROVIDER=gemini
LLM_STAGE_QUERY_UNDERSTANDING_PRIMARY_MODEL=gemini-1.5-flash
LLM_STAGE_QUERY_UNDERSTANDING_FALLBACK_PROVIDER=openrouter
LLM_STAGE_QUERY_UNDERSTANDING_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

LLM_STAGE_TASK_PLANNING_PRIMARY_PROVIDER=openrouter
LLM_STAGE_TASK_PLANNING_PRIMARY_MODEL=anthropic/claude-3.5-sonnet
LLM_STAGE_TASK_PLANNING_FALLBACK_PROVIDER=gemini
LLM_STAGE_TASK_PLANNING_FALLBACK_MODEL=gemini-1.5-pro

LLM_STAGE_VQA_PRIMARY_PROVIDER=gemini
LLM_STAGE_VQA_PRIMARY_MODEL=gemini-1.5-pro
LLM_STAGE_VQA_FALLBACK_PROVIDER=openrouter
LLM_STAGE_VQA_FALLBACK_MODEL=openai/gpt-4o

LLM_STAGE_RESPONSE_GENERATION_PRIMARY_PROVIDER=gemini
LLM_STAGE_RESPONSE_GENERATION_PRIMARY_MODEL=gemini-1.5-flash
LLM_STAGE_RESPONSE_GENERATION_FALLBACK_PROVIDER=openrouter
LLM_STAGE_RESPONSE_GENERATION_FALLBACK_MODEL=deepseek/deepseek-chat

# Circuit Breaker & Failover Policy
LLM_CIRCUIT_BREAKER_FAIL_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60

# Agent Loop & Policies
MAX_AGENT_STEPS=8
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=120
ENABLE_FALLBACK=true
ENABLE_TOOL_CALLING=true
DEVICE=auto
MAX_CONVERSATION_MESSAGES=20

# Storage Paths
MODEL_CACHE_DIR=./data/models
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
RESULT_DIR=./data/results

# Upload and Processing Limits
MAX_UPLOAD_SIZE_MB=500

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
